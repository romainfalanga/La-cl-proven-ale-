# Variables à créer dans Netlify → Project configuration → Environment variables.
# Ce fichier est un modèle : il ne contient aucune valeur réelle et peut être commité.
# Le vrai .env ne doit JAMAIS être commité (il est dans .gitignore).

# Clé API Resend. Secret absolu : lue uniquement par la Netlify Function,
# jamais exposée au navigateur. Scope : Functions.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Boîte qui reçoit les demandes du formulaire.
CONTACT_TO_EMAIL=contact@lacleprovencale.fr

# Expéditeur des emails. DOIT appartenir à un domaine vérifié dans Resend.
# À ce jour, le seul domaine vérifié sur le compte est lavabio.fr.
# Une fois le domaine définitif de la marque vérifié, remplacer par :
#   CONTACT_FROM_EMAIL="Passala Conciergerie <contact@send.VOTRE-DOMAINE.fr>"
CONTACT_FROM_EMAIL="Passala Conciergerie <contact@lavabio.fr>"
